# Local development only. On Cloud Run these are set by deploy.ps1.
PORT=8080
# "memory" keeps data in RAM (local dev). "firestore" writes to Google Cloud Firestore.
STORAGE=memory
# Required when STORAGE=firestore and running outside Google Cloud:
# GOOGLE_CLOUD_PROJECT=your-project-id
FIRESTORE_COLLECTION=bookings

# Private stats page at /admin (disabled when empty). Log in with this password.
ADMIN_PASSWORD=
# Random string used to make anonymous daily visitor ids. Keep it stable.
STATS_SALT=

# Optional: copy each booking into a Google Sheet (share it with the service account as Editor)
SHEET_ID=
SHEET_TAB=Bookings

# Optional: email each new booking to you (e.g. Gmail with an app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_TO=
NOTIFY_FROM=
